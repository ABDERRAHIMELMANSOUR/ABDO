# Copy this file to .env.local and fill in the values.

# Signs login cookies. Use a long random string (32+ characters).
SESSION_SECRET=

# Accounts created on the very first start (when the database is empty):
# the admin (Abderrahim) plus the employees "ikram" and "ayman", who share EMPLOYEE_PASSWORD
# until they change it with the admin.
ADMIN_USERNAME=abderrahim
ADMIN_NAME=Abderrahim
ADMIN_PASSWORD=
EMPLOYEE_PASSWORD=

# Attendance: arrivals after WORK_START_TIME (+ grace) are "En retard"
TIMEZONE=Africa/Casablanca
WORK_START_TIME=09:00
LATE_GRACE_MINUTES=0

# Google Sheets HR log (see README: "Connect the HR Google Sheet")
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Link to the sheet itself, shown to the admin as "Open HR sheet"
HR_SHEET_URL=

# Live WordPress sites (optional; also read from the database export)
ALM_SITE_URL=
CPA_SITE_URL=

# WhatsApp Cloud API & Meta (see README: "WhatsApp & Meta setup")
# Public HTTPS address of this app, used to show the webhook callback URL
APP_URL=
# Permanent System User token with whatsapp_business_management and whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# Any random string; enter the same value in the Meta app's webhook settings
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app dashboard, used to verify webhook signatures
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Where the SQLite file lives
DATABASE_PATH=data/app.db

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
